# Google OAuth (Drive read-only). Get these from:
#   https://console.cloud.google.com/apis/credentials  ->  "OAuth 2.0 Client ID"
# Then run `npm run auth` once to complete consent and write token.json.
GOOGLE_CLIENT_ID=___
GOOGLE_CLIENT_SECRET=___

# Optional: restrict the Drive scan to a folder ID (the folder's ID from its URL).
# Leave blank to scan the whole Drive (still filtered by type + name).
GOOGLE_DRIVE_FOLDER_ID=

# Where downloaded receipt files are cached for OCR.
RECEIPTS_DIR=./.receipts

# Server
PORT=4000
# Optional: path to the SQLite DB file.
DB_PATH=./receipts.db
